# Copy this file to services/.env and fill in your values.
# The .env file is gitignored — never commit your actual key.
#
# ── Bob Shell ─────────────────────────────────────────────────────────────────
# Generate your Bob API key at https://bob.ibm.com (API Keys section).
# Used by bob-host-agent.sh (and bob-generate-trick.sh).
BOB_API_KEY=your_bob_api_key_here

# ── WiFi ──────────────────────────────────────────────────────────────────────
# The network with internet access used while generating tricks with Bob.
# Change this to match the internet WiFi SSID at each venue.
INTERNET_WIFI=IBMEmployee

# ROVER_WIFI is hardcoded to OL_DEMO in the scripts — only add this line
# if you ever need to override it:
# ROVER_WIFI=OL_DEMO
