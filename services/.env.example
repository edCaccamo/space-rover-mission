# OPTIONAL. Only needed to generate new tricks with Bob in the browser.
# Without it the stack still starts and existing tricks still run.
#
# Copy this file to services/.env and fill in your value.
# The .env file is gitignored — never commit your actual key.
#
# Generate your Bob API key at https://bob.ibm.com (API Keys section).
# docker-compose.freeroam.yml passes this into the bob-bridge container as BOBSHELL_API_KEY,
# which is the environment variable Bob Shell reads for headless API key auth.

BOB_API_KEY=your_bob_api_key_here
